  "crawl": {
    "enable": true,
    "exclude": "",
    "max_fails": 5,
    "include_nodes": true,
    "persist": {
      "subscribe": "crawledsubs",
      "nodes": "crawledproxies"
    },
    "task": {
      "rename": "",
      "include": "",
      "exclude": ""
    },
    "telegram": {
      "enable": false,
      "pages": 5,
      "exclude": "广告|spam|promo|推广",
      "channels": {
        "v2cnf": {
          "include": "",
          "exclude": "",
          "task": {
            "rename": ""
          },
          "push_to": [
            "all"
          ]
        }
      }
    },
    "google": {
      "enable": false,
      "exclude": "",
      "limit": 100,
      "days": 7,
      "exclude_sites": [],
      "push_to": []
    },
    "yandex": {
      "enable": false,
      "exclude": "",
      "days": 3,
      "pages": 5,
      "exclude_sites": [],
      "push_to": []
    },
    "github": {
      "enable": false,
      "pages": 2,
      "push_to": [
        "all"
      ],
      "exclude": "",
      "exclude_repos": [
        "wzdnzd/aggregator"
      ]
    },
    "twitter": {
      "enable": false,
      "users": {}
    },
    "repositories": [],
    "pages": [
      {
        "enable": true,
        "url": "https://v2cross.com/en/free-v2ray-nodes/",
        "include": "",
        "exclude": "",
        "paged": false,
        "placeholder": "",
        "start": 1,
        "end": 1,
        "task": {
          "rename": ""
        },
        "push_to": [
          "all"
        ]
      }
    ],
    "scripts": []
  },
  "groups": {
    "all": {
      "emoji": true,
      "list_only": true,
      "targets": {
        "clash": "mihomo-clash"
      },
      "regularize": {
        "enable": false,
        "locate": false,
        "residential": false,
        "digits": 2
      }
    }
  },
  "storage": {
    "engine": "local",
    "base": "",
    "domain": "https://gist.githubusercontent.com",
    "items": {
      "mihomo-clash": {
        "file_id": "all.yaml",
        "folder_id": "output/checked"
      },
      "crawledsubs": {
        "file_id": "crawledsubs.json",
        "folder_id": "output/raw"
      },
      "crawledproxies": {
        "file_id": "crawledproxies.txt",
        "folder_id": "output/raw"
      }
    }
  }
