# aggregator000 环境变量配置示例
# 复制为 .env 并填入实际值

# ============================================================
# GitHub 数据源爬取令牌
# 用途：aggregator000 的 GitHub 爬虫通过 API 搜索公开仓库和 Issues
# 权限：public_repo（若需搜索私有仓库则需 repo）
# 配置位置：GitHub Settings → Developer settings → Personal access tokens → Fine-grained tokens
# ============================================================
GH_TOKEN=

# GitHub Session Cookie（备选方案，当 GH_TOKEN 不可用时使用）
# 权限：无需额外权限，使用浏览器登录后提取 user_session cookie
GH_COOKIE=

# ============================================================
# GitHub Actions 推送令牌
# 用途：aggregator000 推送采集结果到 GitHub Gist
# 权限：gist
# 配置位置：GitHub Settings → Developer settings → Personal access tokens
# ============================================================
PUSH_TOKEN=

# ============================================================
# 目标私人仓库写入令牌（用于同步最终订阅文件）
# 用途：GitHub Actions 将检测结果同步到指定的私人仓库
# 权限：contents: write（仅对目标仓库）
# 配置位置：GitHub Settings → Developer settings → Personal access tokens
# ============================================================
TARGET_REPO_TOKEN=

# ============================================================
# 目标私人仓库信息
# 格式：OWNER/REPO（例如：myuser/mihomo-subscriptions）
# ============================================================
TARGET_REPO=
TARGET_BRANCH=main

# ============================================================
# 工作流模式（可选）
# 0 = 爬取 + 聚合 + 检测（完整流程）
# 1 = 仅爬取
# 2 = 仅聚合（使用已有爬取结果）
# ============================================================
WORKFLOW_MODE=0

# ============================================================
# 跳过 Clash 活性检查（可选）
# 如果 subs-check 在后续阶段完成检测，可以跳过 aggregator000 的基础活检
# ============================================================
SKIP_ALIVE_CHECK=false

# ============================================================
# 跳过节点重命名（可选）
# ============================================================
SKIP_REMARK=false

# ============================================================
# 启用特殊协议（VLESS / Hysteria2 / Mieru / MASQUE）
# ============================================================
ENABLE_SPECIAL_PROTOCOLS=true

# ============================================================
# 网络代理（Windows / Linux 环境使用）
# 格式：http://host:port
# ============================================================
HTTP_PROXY=http://192.168.31.204:7891
HTTPS_PROXY=http://192.168.31.204:7891

# ============================================================
# Telegram 频道配置（直接在 config.local.json 中填写，不在此处）
# ============================================================
# 注意：Telegram 公共频道列表在 config.local.json 的 crawl.telegram.channels 中配置
# 格式：
# "channels": {
#   "频道名称": {
#     "include": "",
#     "exclude": "",
#     "task": { "rename": "" },
#     "push_to": ["all"]
#   }
# }
